# Copy to backend/.env for local development. Never commit real secrets.
QS_ENVIRONMENT=development
QS_DATABASE_URL=postgresql+psycopg://qs_app:qs_app_dev@localhost:5432/qs_dev
QS_MIGRATION_DATABASE_URL=postgresql+psycopg://qs_owner:qs_owner_dev@localhost:5432/qs_dev
QS_REDIS_URL=redis://localhost:6379/0
QS_STORAGE_BACKEND=local
QS_STORAGE_LOCAL_PATH=./var/storage
QS_PUBLIC_APP_URL=http://localhost:3000
# Regional deployment this stack serves: "us" or "uk" (each region has its own database and storage).
QS_DEPLOYMENT_REGION=us

# Email. Development logs messages to the console; staging/production must use SMTP.
QS_EMAIL_BACKEND=console
QS_EMAIL_FROM_NAME=QS Intelligence
QS_EMAIL_FROM_ADDRESS=clearviewqs@gmail.com
# Gmail SMTP (requires 2-Step Verification on the Google account and an App Password):
# QS_EMAIL_BACKEND=smtp
# QS_SMTP_HOST=smtp.gmail.com
# QS_SMTP_PORT=587
# QS_SMTP_USERNAME=clearviewqs@gmail.com
# QS_SMTP_PASSWORD=   <- Google App Password; set via the secret manager, never commit it
# Required outside development (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))")
# QS_JWT_SECRET=
# Required outside development (generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# QS_FIELD_ENCRYPTION_KEY=
# QS_COOKIE_SECURE=true
